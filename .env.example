# ==========================================
# Phoenix Core - Environment Variables Template
# Copy this file to `.env` and fill in real values.
# Never commit the actual `.env` file.
# ==========================================

# --- AI Layer (DeepSeek and Groq — Task 014; both use the same request format) ---
PHOENIX_AI_DEEPSEEK_API_KEY=
PHOENIX_AI_DEEPSEEK_MODEL=deepseek-v4-flash
PHOENIX_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
PHOENIX_AI_DEEPSEEK_TIMEOUT=30
PHOENIX_AI_DEEPSEEK_MAX_RETRIES=3
# Groq — plain GROQ_* names (not PHOENIX_AI_GROQ_*), matching Groq's own SDK/docs convention
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=30
GROQ_MAX_RETRIES=3
# Which configured provider AIRouter uses by default: "deepseek" (default) or "groq"
AI_DEFAULT_PROVIDER=deepseek
# Max allowed /ask prompt length, in characters (default: 4000)
AI_MAX_PROMPT_LENGTH=4000
# Conversation Memory Engine (Task 010)
AI_MAX_CONVERSATION_MESSAGES=20
AI_MAX_CONTEXT_CHARS=8000
# AI Guard Layer (Task 011)
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW=60
AI_GUARD_MAX_CONTEXT_CHARS=12000
AI_GUARD_MAX_RETRIES=2
# Conversation storage backend (Task 012)
MEMORY_BACKEND=sqlite
SQLITE_DATABASE=phoenix.db

# --- Telegram (bot commands: /start /help /version /status /health /repo
# /issues /plugins /ai /ask /reset /memory /crypto /intel /explain /consensus
# /benchmark /strategy /copilot /brief /news /fear /gas /watch /research) ---
PHOENIX_TELEGRAM_BOT_TOKEN=
# --- Chanify advertising / Telegram monetization ---
# Keep the real API key only in .env. Never commit it.
PHOENIX_CHANIFY_ENABLED=false
PHOENIX_CHANIFY_API_KEY=



# --- Crypto market data (CoinGecko — no API key required) ---
PHOENIX_CRYPTO_ENABLED=true
PHOENIX_CRYPTO_BASE_URL=
PHOENIX_CRYPTO_TIMEOUT=15
PHOENIX_CRYPTO_MAX_RETRIES=2
PHOENIX_CRYPTO_CACHE_TTL_SECONDS=60.0

# --- News (Google News RSS — no API key required) ---
PHOENIX_NEWS_ENABLED=true
PHOENIX_NEWS_API_TOKEN=
PHOENIX_NEWS_BASE_URL=
PHOENIX_NEWS_TIMEOUT=15
PHOENIX_NEWS_MAX_RETRIES=2
PHOENIX_NEWS_CACHE_TTL_SECONDS=60.0

# --- Alerts (background watchlist monitoring — /watch) ---
PHOENIX_ALERTS_ENABLED=true
PHOENIX_ALERTS_POLL_INTERVAL_SECONDS=300.0
PHOENIX_ALERTS_COOLDOWN_SECONDS=1800.0

# --- GitHub ---
PHOENIX_GITHUB_TOKEN=
PHOENIX_GITHUB_OWNER=
PHOENIX_GITHUB_REPO=

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PHOENIX_SECURITY_SECRET_KEY=

# --- Logging (optional, defaults shown) ---
PHOENIX_LOG_LEVEL=INFO
PHOENIX_LOG_FORMAT=json
